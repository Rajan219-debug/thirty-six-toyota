# Thirty Six Toyota — production environment template.
# Copy to `.env` next to docker-compose.yml and fill in every value below.
# `docker compose up` will refuse to start if any required (":?") value in
# docker-compose.yml is missing — that's deliberate, not a bug.
#
# NEVER commit the real .env. It's already in .gitignore.

# ---- Secrets: generate real, random values. Do not reuse the ones below. ----

# JWT signing secret. Anyone who has this can forge a login token for any
# user, including an admin. Generate with: openssl rand -hex 32
VIKUNJA_JWT_SECRET=

# Postgres superuser password (the `db` container's own admin account).
VIKUNJA_DB_PASSWORD=

# Password for the non-superuser `vikunja_app` role the API actually connects
# as. This is the role Row-Level Security (multi-outlet isolation) depends on
# — see docker/postgres-init/10-vikunja-app-role.sh. Generate a real password;
# do not reuse VIKUNJA_DB_PASSWORD.
VIKUNJA_APP_DB_PASSWORD=

# ---- Networking ----

# Bare domain (no scheme) that DNS points at this server. Caddy (wired up in
# docker-compose.yml via ./Caddyfile) uses this to request and renew a free
# Let's Encrypt TLS certificate automatically — nothing else to configure,
# as long as the domain's A/AAAA record points here and ports 80+443 are
# reachable from the internet.
VIKUNJA_DOMAIN=tasks.yourdealership.example

# The public URL staff will actually use — same host as VIKUNJA_DOMAIN above,
# with https:// and a trailing slash.
VIKUNJA_PUBLIC_URL=https://tasks.yourdealership.example/
# Local-only port the app binds to behind Caddy (see docker-compose.yml) —
# not exposed to the internet directly. The default is fine unless it
# collides with something else already running on the VPS.
VIKUNJA_PORT=3456

# ---- Email ----
# A personal Gmail account (used during development) is fine for testing but
# is NOT appropriate for production: it has daily sending limits, isn't built
# for transactional/bulk mail, and ties deliverability to one person's
# account. Use a dedicated transactional provider or the dealership's real
# mail relay — no code change needed either way, it's all plain SMTP:
#
#   SendGrid:  HOST=smtp.sendgrid.net       PORT=587  USERNAME=apikey            PASSWORD=<your API key>
#   Postmark:  HOST=smtp.postmarkapp.com    PORT=587  USERNAME=<server token>    PASSWORD=<same server token>
#   AWS SES:   HOST=email-smtp.<region>.amazonaws.com  PORT=587  USERNAME/PASSWORD=<SMTP credentials from the SES console, NOT your AWS access key>
#   Mailgun:   HOST=smtp.mailgun.org        PORT=587  USERNAME=postmaster@<your Mailgun domain>  PASSWORD=<SMTP password from the Mailgun dashboard>
#
# Verify with a real send before considering this phase done (e.g. assign a
# task to yourself and confirm the notification email arrives).
VIKUNJA_MAILER_ENABLED=true
VIKUNJA_MAILER_HOST=
VIKUNJA_MAILER_PORT=587
VIKUNJA_MAILER_USERNAME=
VIKUNJA_MAILER_PASSWORD=
VIKUNJA_MAILER_FROMEMAIL=noreply@yourdealership.example

# ---- Backups ----
# db-backup-prod.sh (wire it into cron — see the script's own header for the
# line) dumps the DB and ships it off-box. Set exactly one of these:
BACKUP_REMOTE=
BACKUP_S3_BUCKET=

# ---- Multi-outlet tenancy ----
# Every request path, cron job, and CalDAV/feed session now binds a tenant
# (see plans/thirtysixtoyota-multitenancy.md). Before setting this to 1 in
# production: re-run the two-tenant isolation test ("the one check that
# matters" in that plan) against the real production DB, and confirm the
# app connects as the non-superuser vikunja_app role (see docker-compose.yml)
# — RLS is silently bypassed by a superuser role.
# Turning this on before that work is done will break user registration and
# reminder/notification crons (they'll fail their RLS WITH CHECK on insert).
VIKUNJA_MULTITENANCY_ENFORCE=0

# ---- Rate limiting ----
# The strict per-IP + per-account backoff on login/register/password-reset is
# always on and does not need a flag. These control the general tiers on top
# of it; the defaults below are reasonable starting points, not requirements.
VIKUNJA_RATELIMIT_ENABLED=true
VIKUNJA_RATELIMIT_LIMIT=100
VIKUNJA_RATELIMIT_PERIOD=60
