# Thirty Six Toyota — production environment template.
# Copy to `.env` next to docker-compose.yml and fill in every value below.
# `docker compose up` will refuse to start if any required (":?") value in
# docker-compose.yml is missing — that's deliberate, not a bug.
#
# NEVER commit the real .env. It's already in .gitignore.

# ---- Secrets: generate real, random values. Do not reuse the ones below. ----

# JWT signing secret. Anyone who has this can forge a login token for any
# user, including an admin. Generate with: openssl rand -hex 32
VIKUNJA_JWT_SECRET=

# Postgres superuser password (the `db` container's own admin account).
VIKUNJA_DB_PASSWORD=

# Password for the non-superuser `vikunja_app` role the API actually connects
# as. This is the role Row-Level Security (multi-outlet isolation) depends on
# — see docker/postgres-init/10-vikunja-app-role.sh. Generate a real password;
# do not reuse VIKUNJA_DB_PASSWORD.
VIKUNJA_APP_DB_PASSWORD=

# ---- Networking ----

# The public URL staff will actually use, with the correct scheme. Put a
# reverse proxy (nginx/Caddy/Traefik) in front of this for TLS — the app
# itself serves plain HTTP.
VIKUNJA_PUBLIC_URL=https://tasks.yourdealership.example/
VIKUNJA_PORT=3456

# ---- Email ----
# A personal Gmail account (used during development) is fine for testing but
# is NOT appropriate for production: it has daily sending limits, isn't built
# for transactional/bulk mail, and ties deliverability to one person's
# account. Use a dedicated transactional provider (SendGrid, Postmark, SES,
# Mailgun) or the dealership's real mail relay.
VIKUNJA_MAILER_ENABLED=true
VIKUNJA_MAILER_HOST=
VIKUNJA_MAILER_PORT=587
VIKUNJA_MAILER_USERNAME=
VIKUNJA_MAILER_PASSWORD=
VIKUNJA_MAILER_FROMEMAIL=noreply@yourdealership.example

# ---- Multi-outlet tenancy ----
# Leave at 0 (single-outlet behavior) until the full RLS rollout is finished:
# background cron jobs and the long-tail request handlers (webhooks, admin,
# caldav, feeds, user_settings, avatars, backgrounds, link-share resolution)
# still need to bind a tenant session. See plans/thirtysixtoyota-multitenancy.md.
# Turning this on before that work is done will break user registration and
# reminder/notification crons (they'll fail their RLS WITH CHECK on insert).
VIKUNJA_MULTITENANCY_ENFORCE=0

# ---- Rate limiting ----
# The strict per-IP + per-account backoff on login/register/password-reset is
# always on and does not need a flag. These control the general tiers on top
# of it; the defaults below are reasonable starting points, not requirements.
VIKUNJA_RATELIMIT_ENABLED=true
VIKUNJA_RATELIMIT_LIMIT=100
VIKUNJA_RATELIMIT_PERIOD=60
